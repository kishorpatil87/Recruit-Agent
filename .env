# ─────────────────────────────────────────────────────────────────────────────
# RecruitAI — Environment Variables
# Runs 100% locally with Ollama — zero API cost!
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM: Ollama (local, free, no API key needed!) ─────────────────────────────
# Install: https://ollama.com/download
# Pull model: ollama pull mistral:7b-instruct-q4_K_M
# Start server: ollama serve
OLLAMA_BASE_URL=http://localhost:11434
# Single model for all agents — qwen2.5:1.5b fits in 8GB RAM with other apps
OLLAMA_MODEL=qwen2.5:1.5b
# Analyst model (same model to avoid reloading)
OLLAMA_MODEL_ANALYST=qwen2.5:1.5b
# Context window size — 4096 works well within available RAM
OLLAMA_NUM_CTX=4096

# ── GITHUB API (Optional — enables commit history & streak data) ───────────────
# Create token at: https://github.com/settings/tokens (no scopes needed)
GITHUB_TOKEN=

# ── LINKEDIN ENRICHMENT (Optional — paid) ─────────────────────────────────────
# Proxycurl: https://nubela.co/proxycurl
# Without this key, LinkedIn oEmbed (free) is used as fallback
PROXYCURL_API_KEY=

# ── RANKING WEIGHTS (7 dimensions, must sum to 1.0) ──────────────────────────
WEIGHT_JD_MATCH=0.25
WEIGHT_EDUCATION=0.10
WEIGHT_TECHNICAL_SKILLS=0.15
WEIGHT_PROJECT_QUALITY=0.10
WEIGHT_EXPERIENCE=0.15
WEIGHT_GITHUB=0.15
WEIGHT_LINKEDIN=0.10

# ── SHORTLISTING THRESHOLDS ───────────────────────────────────────────────────
FAST_TRACK_THRESHOLD=88
SHORTLIST_THRESHOLD=75
HOLD_THRESHOLD=50
TOP_N_SHORTLIST=10
ROLE_LEVEL=mid

# ── API SERVER ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080

# ── OUTPUT ────────────────────────────────────────────────────────────────────
OUTPUT_DIR=./output
LOG_LEVEL=INFO
